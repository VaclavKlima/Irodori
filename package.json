{
  "name": "luma",
  "version": "0.1.0",
  "private": true,
  "description": "A local photo library and editor with an AI console.",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "setup:electron": "install-electron",
    "dev": "electron-vite dev",
    "dev:mcp": "node scripts/dev-mcp.mjs",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "node scripts/verify.mjs --functional",
    "check": "node scripts/verify.mjs --fast",
    "mcp:ui": "playwright-mcp --cdp-endpoint=http://127.0.0.1:9222 --caps=vision --output-dir=artifacts/mcp",
    "mcp:check": "node scripts/check-mcp.mjs",
    "mcp:test": "node scripts/verify.mjs --mcp",
    "gpu:check": "node scripts/check-gpu.mjs",
    "hdr:diagnostic": "npm run build && node scripts/hdr-diagnostic.mjs",
    "benchmark:preview": "node scripts/verify.mjs --benchmark",
    "mcp:editor": "node scripts/editor-mcp.mjs",
    "mcp:editor:test": "node scripts/verify.mjs --editor",
    "verify": "node scripts/verify.mjs",
    "check:full": "node scripts/verify.mjs --full",
    "check:all": "node scripts/verify.mjs --all",
    "benchmark:adjustments": "node scripts/verify.mjs --adjustment-benchmark",
    "benchmark:hdr": "node scripts/verify.mjs --hdr-benchmark",
    "benchmark:merge": "node scripts/verify.mjs --merge-benchmark",
    "benchmark:export": "node scripts/verify.mjs --export-benchmark",
    "build:export-native": "bash scripts/ultrahdr/build-native.sh",
    "build:merge-kernels": "node scripts/merge-kernels/build.mjs",
    "benchmark:all": "node scripts/verify.mjs --benchmark-all",
    "research:pipeline": "node scripts/verify.mjs --target research-pipeline --target research-native",
    "research:measure": "node scripts/verify.mjs --target research-measurements --target research-libraries --target research-gpu",
    "research:presentation": "node scripts/verify.mjs --target research-presentation"
  },
  "dependencies": {
    "@colorhythm/libraw-wasm": "^1.1.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "exiftool-vendored": "^38.0.1",
    "lucide-react": "1.46.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@playwright/mcp": "0.0.81",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@webgpu/types": "0.1.72",
    "electron": "44.3.0",
    "electron-vite": "5.0.0",
    "esbuild": "0.25.12",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "^7.0.0"
  },
  "optionalDependencies": {
    "node-darwin-arm64": "npm:node-bin-darwin-arm64@24.20.0",
    "node-darwin-x64": "24.20.0",
    "node-linux-arm64": "24.20.0",
    "node-linux-x64": "24.20.0",
    "node-win-arm64": "24.20.0",
    "node-win-x64": "24.20.0",
    "webgpu": "^0.6.1"
  }
}
